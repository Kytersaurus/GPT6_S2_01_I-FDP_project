// Owner: Role 4 - Marcus. INTERFACE REFERENCE ONLY; do not compile this file.
// Extend the existing game_controller.v beside My_Top_Module.v.
`include "game_defs.vh"

module game_controller (
    input wire clk,
    input wire reset,
    input wire launch_req,
    input wire retry_req,
    input wire edit_req,
    input wire guide_open_req,
    input wire guide_close_req,
    input wire build_valid,
    input wire pig_alive,
    input wire [2:0] init_ready, // [0] Role 1, [1] Role 2, [2] Role 3
    input wire physics_tick,
    input wire world_valid,
    output wire world_ready,
    input wire goal_hit,
    input wire hazard_hit,
    input wire out_of_bounds,

    output wire [2:0] game_state,
    output wire run_init,
    output wire step_start,
    output wire update_release,
    output wire launch_event,
    output wire success_event,
    output wire failure_event
);
    // Role 4: launch only from a valid build; wait for initialisation;
    // issue one step at a time; evaluate outcomes only after world_valid.
    // Pig death/hazard/out-of-bounds take priority over goal success.
endmodule
