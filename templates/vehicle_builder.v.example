// Extend the existing vehicle_builder.v beside My_Top_Module.v.
// Outputs intentionally have no drivers. This is not a working game module.
`include "game_defs.vh"

module vehicle_builder (
    input wire clk,
    input wire reset,
    input wire [2:0] game_state,
    input wire run_init,
    output wire init_ready,

    input wire edit_valid,
    input wire [1:0] edit_op,
    input wire [`LP_CELL_BITS-1:0] edit_cell,
    input wire [`LP_PART_BITS-1:0] edit_part,

    input wire damage_valid,
    output wire damage_ready,
    input wire [`LP_CELLS-1:0] damage_mask,

    output wire [`LP_GRID_BITS-1:0] build_grid,
    output wire [`LP_CELLS-1:0] intact_mask,
    output wire build_valid,
    output wire [3:0] build_error,
    output wire pig_alive,
    output wire [3:0] wheel_count,
    output wire [3:0] engine_count,
    output wire [3:0] balloon_count,
    output wire [7:0] mass_units
);
    // Role 1: own construction storage, inventory and runtime intact state here.
    // Additional inventory outputs and error IDs must be agreed with Role 4.
endmodule
